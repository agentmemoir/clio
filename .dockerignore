# What the image build does not need, which on a working checkout is almost
# everything. The build context is the repository root and `dev/Dockerfile` reads
# one file out of it (`rust-toolchain.toml`), so without this list every build
# sends the whole tree to the daemon -- `target/` alone reaches hundreds of
# thousands of files and several gigabytes -- and pays for them in minutes.
.git/
target/
models/
coverage/
backups/
.agent-tmp/
.ignored/
.logs/
.private/
private/
