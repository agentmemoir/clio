#!/bin/sh
# gate-shim: route heavy cargo and make commands in a Clio checkout through
# scripts/gate.py, which runs each command at most once per working-tree
# fingerprint and replays the stored verdict otherwise.
#
# Install as symlinks named `cargo` and `make` in an early PATH directory:
#   scripts/gate-install.sh
#
# Outside a Clio checkout, or with GATE_RAW=1, this execs the real tool
# unchanged, except that an installed ~/.config/clio/gate-hook may run it
# and record the run. Inside a run started by the gate (GATE_ACTIVE=1) it
# passes through too, so nested commands run for real.
#
# Inside a checkout, `make test-fast`, `make precommit` and `make quick` are
# timed and never cached: a stored result would replay a pass, and their output
# has to stream. An installed gate-hook runs them and records the run; without
# one they pass through.
set -u

self_dir=$(cd "$(dirname "$0")" && pwd -P) || exit 127
self_name=$(basename "$0")

find_real() {
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || dir=.
        candidate="$dir/$self_name"
        [ -x "$candidate" ] || continue
        candidate_dir=$(cd "$dir" 2>/dev/null && pwd -P) || continue
        [ "$candidate_dir" = "$self_dir" ] && continue
        printf '%s\n' "$candidate"
        IFS=$old_ifs
        return 0
    done
    IFS=$old_ifs
    return 1
}

real=$(find_real) || {
    printf 'gate-shim: %s not found on PATH\n' "$self_name" >&2
    exit 127
}

pass_through() {
    exec "$real" "$@"
}

[ "${GATE_RAW:-}" = "1" ] && pass_through "$@"
[ "${GATE_ACTIVE:-}" = "1" ] && pass_through "$@"

root=$(git rev-parse --show-toplevel 2>/dev/null) || pass_through "$@"
if [ ! -f "$root/scripts/gate.py" ]; then
    # Outside clio, the hook runs the real tool and returns its exit code, or it is absent.
    [ -x "${HOME:-}/.config/clio/gate-hook" ] && exec "${HOME:-}/.config/clio/gate-hook" "$root" "$real" "$@"
    pass_through "$@"
fi
[ -f "$root/Cargo.toml" ] || pass_through "$@"

heavy=0
if [ "$self_name" = "cargo" ]; then
    case "${1:-}" in
        test | nextest | llvm-cov | clippy) heavy=1 ;;
    esac
elif [ "$self_name" = "make" ]; then
    timed=0
    for arg in "$@"; do
        case "$arg" in
            -*) continue ;;
        esac
        case "$arg" in
            ritual | check | test | lint | coverage | cov | coverage-fast | coverage-clean | coverage-html | coverage-lcov | coverage-open | coverage-package)
                heavy=1
                break
                ;;
            test-fast | precommit | quick)
                timed=1
                break
                ;;
        esac
    done
    if [ "$heavy" = 1 ] || [ "$timed" = 1 ]; then
        dry_run=$(python3 "$root/scripts/gate_classify.py" "$real" "$@") || pass_through "$@"
        [ "$dry_run" = 1 ] && pass_through "$@"
    fi
    [ "$timed" = 1 ] && [ -x "${HOME:-}/.config/clio/gate-hook" ] &&
        exec "${HOME:-}/.config/clio/gate-hook" "$root" "$real" "$@"
fi
[ "$heavy" = 1 ] || pass_through "$@"

if [ -n "${CLIO_GATE_LOG_DIR:-}" ]; then
    python3 "$root/scripts/gate.py" run --log-dir "$CLIO_GATE_LOG_DIR" -- "$real" "$@"
else
    python3 "$root/scripts/gate.py" run -- "$real" "$@"
fi
rc=$?
if [ "$rc" = 70 ]; then
    printf 'gate-shim: gate failed; running %s directly\n' "$self_name" >&2
    exec "$real" "$@"
fi
exit "$rc"
