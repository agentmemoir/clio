# Copy to .env and adjust. Used by compose.yml and (later) the Agent Memoir CLI.
# Note: `clio compose up` generates a restricted-permission .env with these
# values (embed model from the effective config) in the compose root; this
# file documents the variables. Online-service API keys are not written there.
# Host ports start at 34310 (see compose.yml).
# The managed Postgres has no password: compose.yml publishes its port on
# 127.0.0.1 only and asks the image for trust authentication. A POSTGRES_PASSWORD
# here is ignored — compose.yml no longer reads one.
#
# Every name below carries the CLIO_ prefix. Only the prefixed spelling is read,
# so an unprefixed name here has no effect at all. The names inside the
# containers are a separate set that this file does not list: compose.yml passes
# values to the sidecars under their own names, which no setting here changes.
#
# Arch is selected with a Compose -f flag (do not rely on CLIO_TEI_IMAGE alone):
#   docker compose -f compose.yml -f compose.amd64.yml --profile local-rft up -d
#   docker compose -f compose.yml -f compose.arm64.yml --profile local-rft up -d

# --- Postgres (all profiles) ---
CLIO_POSTGRES_USER=clio
CLIO_POSTGRES_DB=clio
CLIO_POSTGRES_PORT=34310
CLIO_DATABASE_URL=postgres://clio@127.0.0.1:34310/clio
CLIO_PG_SHARED_BUFFERS=128MB
CLIO_PG_WORK_MEM=4MB
CLIO_PG_MAX_CONNECTIONS=50

# --- Ops profile: physical backup destination (compose.yml `pg-tools`) ---
# Repository-root directory mounted read-write at /backups in the opt-in
# `pg-tools` service. Create it yourself, owner-only (`mkdir -m 700 backups`);
# a physical clone holds the whole store, so treat it like the store itself.
# The root-anchored /backups ignore rule covers the default below. Pointing it
# somewhere else is allowed, but that copy is then outside the ignore rule.
CLIO_PG_BACKUP_DIR=./backups

# --- TEI (optional override; arch files set the correct default) ---
# amd64:  ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# arm64:  ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
# CLIO_TEI_IMAGE=
CLIO_HF_TOKEN=

# --- Profile B / C: local embed + rerank ---
CLIO_EMBED_PORT=34311
CLIO_RERANK_PORT=34312
CLIO_EMBED_MODEL=BAAI/bge-small-en-v1.5
CLIO_RERANK_MODEL=onnx-community/gte-multilingual-reranker-base
# Same model as Alibaba-NLP/gte-multilingual-reranker-base; onnx-community adds
# onnx/model.onnx so TEI CPU (ORT) can start. Candle+safetensors OOMs on 8–12GB hosts.
CLIO_EMBED_URL=http://127.0.0.1:34311
CLIO_RERANK_URL=http://127.0.0.1:34312
CLIO_EMBED_MEM_LIMIT=1G
CLIO_RERANK_MEM_LIMIT=3G
CLIO_EMBED_MAX_BATCH_TOKENS=1024
CLIO_EMBED_TOKENIZATION_WORKERS=1
CLIO_EMBED_MAX_CONCURRENT=32
# TEI default max-batch-tokens=16384 OOMs CPU warmup; keep small for laptops.
CLIO_RERANK_MAX_BATCH_TOKENS=2048
CLIO_RERANK_MAX_CLIENT_BATCH=32
# TEI reranker cap per request; must not exceed CLIO_RERANK_MAX_CLIENT_BATCH above.
CLIO_RERANK_MAX_BATCH=32
CLIO_RERANK_TOKENIZATION_WORKERS=2
CLIO_RERANK_MAX_CONCURRENT=64

# --- Profile C: local NuExtract extractor ---
CLIO_EXTRACT_PORT=34313
CLIO_EXTRACT_URL=http://127.0.0.1:34313
CLIO_EXTRACT_GGUF=numind.NuExtract-tiny-v1.5.Q4_K_M.gguf
# 2048 ctx + 1 parallel slot: enough for short extract prompts; cuts KV RAM.
CLIO_EXTRACT_CTX=2048
CLIO_EXTRACT_PARALLEL=1
CLIO_EXTRACT_THREADS=2
CLIO_EXTRACT_MEM_LIMIT=768M
CLIO_LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# --- Profile A / B: hosted provider knobs (CLI config; not used by compose) ---
# The CLI transport speaks http:// (local sidecars) and https:// (verified TLS).
# Provider selection: CLIO_EMBED_PROVIDER=tei|openai, CLIO_RERANK_PROVIDER=tei|cohere
# (empty = unset; an empty embed provider keeps the TEI shape). Bearer keys are
# masked in config_get and never logged.
# CLIO_EMBED_PROVIDER=openai     # posts {CLIO_EMBED_URL}/v1/embeddings
# CLIO_EMBED_API_KEY=
# CLIO_EMBED_DIMS=1536           # must match the model; 384 is the default
# CLIO_EMBED_MODEL=text-embedding-3-small
# Changing CLIO_EMBED_MODEL/CLIO_EMBED_DIMS for an existing database rebuilds
# derived vectors only, and requires the explicit opt-in below plus `clio ops reindex`.
# EMBED_SWITCH_SPACE is not an env var, prefixed or not; set
# embed.switch_space=true in the deployment config
# (`config_set embed.switch_space true --scope deployment`).
# CLIO_RERANK_PROVIDER=tei|cohere  # empty = tei sidecar; cohere posts {CLIO_RERANK_URL}/v1/rerank
# CLIO_RERANK_MODEL=rerank-v3.5    # required when CLIO_RERANK_URL is set; use a reranker model
# CLIO_RERANK_API_KEY=              # required for CLIO_RERANK_PROVIDER=cohere (hosted)

# --- Hosted extraction (optional; sends source text to a third party) ---
# CLIO_EXTRACT_PROVIDER=template|openai   # template (default) = local NuExtract sidecar;
#                                         # openai = hosted chat-completions adapter
# With CLIO_EXTRACT_PROVIDER=openai, CLIO_EXTRACT_URL is an OpenAI-compatible API
# BASE URL (the adapter posts {CLIO_EXTRACT_URL}/v1/chat/completions),
# CLIO_EXTRACT_MODEL is the chat model id, and CLIO_EXTRACT_API_KEY (or
# credentials.extract_api_key) is the required bearer key. Keys are masked in
# config_get and never logged.
# Caveat: prompt-based extraction is less reliable than the fine-tuned local
# NuExtract model; the span verifier rejects ungrounded snapshots. Source text
# is secret-scrubbed inline, but the full text still leaves the process.
# CLIO_EXTRACT_PROVIDER=openai
# CLIO_EXTRACT_URL=https://api.openai.com
# CLIO_EXTRACT_MODEL=gpt-4o-mini
# CLIO_EXTRACT_API_KEY=

# --- Hosted memory provider (optional; MCP tool surface only) ---
# The memory tools read this bearer key when the tool call carries no
# credentials of its own, and the default base URL is Mem0's. The tools mask the
# key wherever they list credentials.
# CLIO_MEM0_API_KEY=

# --- SQLite alternative (no Compose; CLI only) ---
# With no flags, no config file, and no env vars the CLI persists to
# $XDG_DATA_HOME/clio/clio.db, else ~/.local/share/clio/clio.db.
# CLIO_DATA_DIR overrides the directory (the CLI appends clio.db):
# CLIO_DATA_DIR=/tmp/clio-data     # -> /tmp/clio-data/clio.db
# The CLI honors CLIO_DATABASE_URL above (Postgres backend inferred from the
# postgres:// scheme); an explicit --db always wins over every env var.
# CLIO_DATABASE_URL=sqlite:./data/clio.db
# Migrations: sql/001_core.sql then sql/002_vectors_sqlite.sql (sqlite-vec required)

# --- Test-only: Postgres fail-closed opt-out ---
# Postgres-backed tests fail when the database cannot be opened, so a green
# suite proves the Postgres path ran. Set this to 1, true, or yes to print a
# skip note and return instead; unset, or any other value, keeps the strict
# default. Compose does not read this; it is for `make test`/CI runs.
# CLIO_SKIP_PG_TESTS=1

# --- Binary configuration ---
# The `clio` binary's own settings (embed/rerank provider, endpoint, model, keys)
# are NOT read from this file. `clio setup` writes them to the deployment config
# overlay at $XDG_CONFIG_HOME/clio/deployment.json (fallback ~/.config/clio/deployment.json).
# This file only carries the variables compose.yml needs.
